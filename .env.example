# ==============================================================================
# KAMRUL ISLAM PORTFOLIO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local to configure local development credentials.
# Never commit .env.local or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTH CONFIGURATION (CMS & ADMIN DASHBOARD)
# ------------------------------------------------------------------------------
# Project URL from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable API Key (anon public key) from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_publishable_key_here

# Optional: Service Role Key (ONLY for offline node scripts like scripts/seed-projects.mjs)
# NEVER prefix with NEXT_PUBLIC_* and NEVER commit to git!
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ------------------------------------------------------------------------------
# 2. EMAIL DELIVERY CONFIGURATION (RESEND)
# ------------------------------------------------------------------------------
# Resend API Key (from https://resend.com/api-keys)
# Starts with "re_..."
RESEND_API_KEY=re_your_api_key_here

# Destination email where contact form submissions should be delivered
# Example: your_inbox@example.com
CONTACT_TO_EMAIL=your_inbox@example.com

# Verified sender address configured in Resend
# CONTACT_FROM_EMAIL="Your Name <contact@yourdomain.com>"
CONTACT_FROM_EMAIL="Your Name <contact@yourdomain.com>"

# Optional: Automated courtesy auto-reply sender address
# AUTOREPLY_FROM_EMAIL="Your Name (No-Reply) <noreply@yourdomain.com>"
AUTOREPLY_FROM_EMAIL="Your Name (No-Reply) <noreply@yourdomain.com>"


