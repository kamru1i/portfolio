# ==============================================================================
# KAMRUL ISLAM PORTFOLIO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local to configure local development credentials.
# Never commit .env.local or secret keys to version control.
# ==============================================================================

# Resend API Key (from https://resend.com/api-keys)
# Starts with "re_..."
RESEND_API_KEY=re_your_api_key_here

# Destination email where contact form submissions should be delivered
# Defaults to inquiry.kamrul@gmail.com if omitted
CONTACT_TO_EMAIL=inquiry.kamrul@gmail.com

# Verified sender address configured in Resend
# Defaults to onboarding@resend.dev (Resend test sender)
# When your custom domain (e.g. kamrulislam.bd) is verified in Resend, change to:
# CONTACT_FROM_EMAIL=Kamrul Islam <contact@kamrulislam.bd>
CONTACT_FROM_EMAIL="Kamrul Islam Portfolio <onboarding@resend.dev>"

# Optional: Automated courtesy auto-reply sender address
# Once your domain is verified on Resend, configure:
# AUTOREPLY_FROM_EMAIL="Kamrul Islam (No-Reply) <noreply@inquiry.kamrul.bd>"
AUTOREPLY_FROM_EMAIL="Kamrul Islam (No-Reply) <onboarding@resend.dev>"
